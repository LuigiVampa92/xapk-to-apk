# This is an example file with configuration to resign the repacked apk files automatically.
# Set sign.enabled to true and fill in the values of the keystore that will be used to sign the result apks.
# Rename or copy this file to "xapktoapk.sign.properties" and put it in the script directory (if you run the script locally) or in your user home directory.

sign.enabled=false
sign.keystore.file=ABSOLUTE_PATH_TO_KEYSTORE_FILE.keystore
sign.keystore.password=KEYSTORE_PASSWORD
sign.key.alias=KEY_ALIAS
sign.key.password=KEY_PASSWORD

# By default all signature schemes (v1/v2/v3) are enabled.
# You can explicitly toggle each scheme with the values below (true/false):
# sign.v1.enabled=true
# sign.v2.enabled=true
# sign.v3.enabled=true

# Optional: zipalign page size for native libs, in KB. Default is 4.
# Set to 16 to support Android 15+ devices with 16 KB page size (requires build-tools 34+):
# zipalign.page.size=4
